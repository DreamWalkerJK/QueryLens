<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="QueryLens.Desktop.Views.MainWindow" Title="QueryLens · 数据库慢查询诊断" Width="1400" Height="900" MinWidth="1100" MinHeight="700" x:CompileBindings="False">
 <Grid RowDefinitions="Auto,*" Margin="24">
  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18"><StackPanel><TextBlock Text="QueryLens" FontSize="30" FontWeight="Bold"/><TextBlock Text="数据库慢查询与执行计划分析" Opacity="0.7"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><CheckBox Content="离线样例模式" IsChecked="{Binding OfflineMode}"/><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" MaxWidth="520" TextWrapping="Wrap"/></StackPanel></Grid>
  <TabControl Grid.Row="1">
   <TabItem Header="连接与能力"><Grid ColumnDefinitions="360,*" ColumnSpacing="18" Margin="0,18"><Border Background="#202938" CornerRadius="10" Padding="18"><StackPanel Spacing="11"><TextBlock Text="连接管理" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="连接名称"/><TextBox Text="{Binding ConnectionName}"/><TextBlock Text="数据库类型 / 产品形态"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><ComboBox ItemsSource="{Binding Dialects}" SelectedItem="{Binding DialectText}"/><TextBox Grid.Column="1" Text="{Binding ProductVariant}" PlaceholderText="GaussDB 产品形态（可选）"/></Grid><TextBlock Text="认证方式"/><ComboBox ItemsSource="{Binding AuthenticationModes}" SelectedItem="{Binding AuthenticationText}"/><TextBlock Text="主机 / 端口"/><Grid ColumnDefinitions="*,90" ColumnSpacing="8"><TextBox Text="{Binding Host}"/><TextBox Grid.Column="1" Text="{Binding Port}"/></Grid><TextBlock Text="数据库 / 用户"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox Text="{Binding Database}"/><TextBox Grid.Column="1" Text="{Binding UserName}"/></Grid><TextBlock Text="密码（仅当前编辑会话）"/><TextBox Text="{Binding PasswordInput}" PasswordChar="●"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><CheckBox Content="TLS 证书校验" IsChecked="{Binding UseTls}"/><TextBox Grid.Column="1" Text="{Binding TimeoutSeconds}" PlaceholderText="超时秒数"/></Grid><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存连接" Command="{Binding SaveConnectionCommand}"/><Button Content="测试连接" Command="{Binding TestConnectionCommand}"/><Button Content="复制" Command="{Binding DuplicateConnectionCommand}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><CheckBox Content="确认删除" IsChecked="{Binding ConfirmDelete}"/><Button Content="删除所选连接" Command="{Binding DeleteConnectionCommand}"/><Button Content="加载离线样例" Command="{Binding LoadOfflineSamplesCommand}"/></StackPanel><TextBlock Text="默认只读；不会自动启用扩展、Query Store 或全局参数。" Opacity="0.65" TextWrapping="Wrap"/></StackPanel></Border><StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="已保存连接" FontSize="19" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" Height="180"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Dialect}"/><TextBlock Text="{Binding Host}" Opacity="0.7"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="实例能力概览" FontSize="19" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Capabilities}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#465568" BorderThickness="0,0,0,1" Padding="8"><Grid ColumnDefinitions="210,120,*"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Status}"/><TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid></TabItem>
   <TabItem Header="慢查询与指纹"><Grid RowDefinitions="Auto,Auto,*" Margin="0,18" RowSpacing="12"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding QueryImportPath}" PlaceholderText="慢查询日志或 JSON 快照路径"/><ComboBox Grid.Column="1" ItemsSource="{Binding ImportFormats}" SelectedItem="{Binding ImportFormatText}"/><Button Grid.Column="2" Content="导入" Command="{Binding ImportQueriesCommand}"/><Button Grid.Column="3" Content="在线采集" Command="{Binding CollectCommand}"/></Grid><TextBlock Grid.Row="1" Text="{Binding SelectedQuerySummary}" Opacity="0.75"/><ListBox Grid.Row="2" ItemsSource="{Binding Queries}" SelectedItem="{Binding SelectedQuery}"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" BorderBrush="#465568" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="130,*,120,90,120" ColumnSpacing="10"><TextBlock Text="{Binding Fingerprint}"/><TextBlock Grid.Column="1" Text="{Binding RedactedSql}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Dialect}"/><TextBlock Grid.Column="3" Text="{Binding Calls}"/><TextBlock Grid.Column="4" Text="{Binding IsOfflineSample}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
   <TabItem Header="执行计划与诊断"><Grid ColumnDefinitions="*,430" ColumnSpacing="18" Margin="0,18"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="计划列表" FontSize="19" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="导入计划" Command="{Binding ImportPlanCommand}"/><Button Content="标记基线" Command="{Binding SelectBaselineCommand}"/><Button Content="比较" Command="{Binding CompareSelectedPlansCommand}"/></StackPanel></Grid><TextBox Text="{Binding PlanImportPath}" PlaceholderText="JSON/XML 计划路径"/><ListBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" Height="180"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Root.NodeType}" FontWeight="SemiBold"/><TextBlock Text="{Binding Dialect}"/><TextBlock Text="{Binding SourceVersion}"/><TextBlock Text="{Binding IsBaseline}"/><TextBlock Text="{Binding IsOfflineSample}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Border Background="#202938" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="计划树" FontSize="17" FontWeight="SemiBold"/><ScrollViewer Height="260"><TextBlock Text="{Binding SelectedPlanText}" FontFamily="Consolas" TextWrapping="NoWrap"/></ScrollViewer></StackPanel></Border><Expander Header="原始 JSON/XML"><ScrollViewer Height="180"><TextBlock Text="{Binding RawPlanText}" FontFamily="Consolas" TextWrapping="Wrap"/></ScrollViewer></Expander></StackPanel><StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="诊断建议" FontSize="19" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#D79B32" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"><StackPanel Spacing="5"><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap"/><TextBlock Text="{Binding Verification}" TextWrapping="Wrap" Opacity="0.8"/><TextBlock Text="{Binding Severity}" Opacity="0.8"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="计划变化" FontSize="17" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding PlanChanges}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid></TabItem>
   <TabItem Header="采集任务与设置"><StackPanel Margin="0,18" Spacing="12"><TextBlock Text="导出与保留" FontSize="19" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding ReportExportPath}"/><CheckBox Grid.Column="1" Content="显式包含原始 SQL" IsChecked="{Binding IncludeRawSql}"/><Button Grid.Column="2" Content="导出脱敏报告" Command="{Binding ExportReportCommand}"/></Grid><TextBlock Text="导出默认为脱敏内容；只有用户明确勾选才会包含原始 SQL。" Opacity="0.7"/><Separator/><TextBlock Text="任务状态" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="取消采集" Command="{Binding CollectCancelCommand}"/><Button Content="取消日志导入" Command="{Binding ImportQueriesCancelCommand}"/><Button Content="取消计划导入" Command="{Binding ImportPlanCancelCommand}"/><Button Content="取消导出" Command="{Binding ExportReportCancelCommand}"/><Button Content="刷新当前模式" Command="{Binding RefreshCommand}"/></StackPanel><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/><TextBlock Text="长任务通过异步命令执行，可取消；连接、解析、权限和数据质量错误会在状态栏给出可操作说明。" Opacity="0.7" TextWrapping="Wrap"/></StackPanel></TabItem>
  </TabControl>
 </Grid>
</Window>
