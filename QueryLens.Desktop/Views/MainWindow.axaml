<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="QueryLens.Desktop.Views.MainWindow" Title="QueryLens · 数据库慢查询诊断" Width="1280" Height="800" MinWidth="1000" MinHeight="650">
 <Grid RowDefinitions="Auto,*" Margin="24">
  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18"><StackPanel><TextBlock Text="QueryLens" FontSize="30" FontWeight="Bold"/><TextBlock Text="数据库慢查询与执行计划分析" Opacity="0.7"/></StackPanel><Border Grid.Column="1" Background="#493D20" CornerRadius="6" Padding="12,8"><TextBlock Text="离线样例模式 · 不连接真实数据库"/></Border></Grid>
  <TabControl Grid.Row="1">
   <TabItem Header="连接与能力"><Grid ColumnDefinitions="330,*" ColumnSpacing="18" Margin="0,18"><Border Background="#202938" CornerRadius="10" Padding="18"><StackPanel Spacing="14"><TextBlock Text="连接管理" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="连接名称"/><TextBox Text="本地样例连接"/><TextBlock Text="主机 / 端口"/><Grid ColumnDefinitions="*,90" ColumnSpacing="8"><TextBox Text="localhost"/><TextBox Grid.Column="1" Text="5432"/></Grid><TextBlock Text="认证与 TLS"/><ComboBox SelectedIndex="0"><ComboBoxItem>密码（受保护存储）</ComboBoxItem><ComboBoxItem>操作系统凭据</ComboBoxItem></ComboBox><CheckBox Content="启用 TLS" IsChecked="True"/><Button Content="测试连接"/><TextBlock Text="默认只读；不会自动启用扩展、Query Store 或全局参数。" Opacity="0.65" TextWrapping="Wrap"/></StackPanel></Border><StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="实例能力概览" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="版本识别 · 已验证 · SELECT VERSION()"/><TextBlock Text="慢查询统计 · 未验证 · 需要扩展或 Query Store"/><TextBlock Text="执行计划导入 · 离线可用 · 无数据库权限"/><TextBlock Text="GaussDB · 待验证 · 需产品形态与驱动"/><TextBlock Text="每种采集方式会显示最小权限和影响。" Opacity="0.65"/></StackPanel></Grid></TabItem>
   <TabItem Header="慢查询与指纹"><Grid RowDefinitions="Auto,*" Margin="0,18" RowSpacing="12"><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="导入慢查询日志"/><Button Content="导入统计快照"/><Button Content="刷新采集"/></StackPanel><StackPanel Grid.Row="1" Spacing="10"><TextBlock Text="QRY-001  ·  SELECT * FROM orders WHERE customer_id = ?  ·  PostgreSQL  ·  1840 次  ·  42.8 ms"/><TextBlock Text="QRY-002  ·  SELECT u.id, count(*) FROM users ...  ·  MySQL  ·  923 次  ·  18.4 ms"/><TextBlock Text="QRY-003  ·  SELECT TOP 100 * FROM audit_log ...  ·  SQL Server  ·  301 次  ·  7.9 ms"/><TextBlock Text="原始 SQL 默认不导出；生产列表使用分页或虚拟化。" Opacity="0.65"/></StackPanel></Grid></TabItem>
   <TabItem Header="执行计划与诊断"><Grid ColumnDefinitions="*,420" ColumnSpacing="18" Margin="0,18"><StackPanel Spacing="14"><TextBlock Text="查询详情" FontSize="19" FontWeight="SemiBold"/><TextBox Text="SELECT * FROM orders WHERE customer_id = 42 ORDER BY created_at DESC" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="打开计划文件"/><Button Content="保存为基线"/><Button Content="比较计划"/></StackPanel><Border Background="#202938" CornerRadius="10" Padding="18"><StackPanel Spacing="10"><TextBlock Text="计划树" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="▾ Sort（成本单位：PostgreSQL cost）"/><TextBlock Text="  └─ ▾ Seq Scan orders"/><TextBlock Text="       └─ Filter: customer_id = $1" Opacity="0.8"/><TextBlock Text="缺失实际行数和耗时，不填造默认性能数据。" Opacity="0.65"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="1" Spacing="14"><TextBlock Text="可解释诊断建议" FontSize="19" FontWeight="SemiBold"/><Border BorderBrush="#D79B32" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="6"><TextBlock Text="高 · 估算行数可能偏差" FontWeight="Bold"/><TextBlock Text="证据：实际行数缺失。验证：导入真实执行计划或执行受控分析。误报：统计信息更新后可能消失。" TextWrapping="Wrap"/></StackPanel></Border><Border BorderBrush="#5D9CEC" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="6"><TextBlock Text="中 · 排序可能产生临时开销" FontWeight="Bold"/><TextBlock Text="证据：计划包含 Sort 节点。检查过滤条件与索引设计；不会自动创建索引。" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></Grid></TabItem>
   <TabItem Header="采集任务与设置"><StackPanel Margin="0,18" Spacing="12"><TextBlock Text="任务记录" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="暂无在线采集任务。导入后会显示进度、取消、部分失败与数据质量错误。" Opacity="0.7"/><Separator/><TextBlock Text="本地数据与安全" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="SQLite 保存元数据、快照、计划和分析结果；密码由 Windows DPAPI 保护，日志与脱敏报告不包含明文密码。" TextWrapping="Wrap"/></StackPanel></TabItem>
  </TabControl>
 </Grid>
</Window>
